        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$@) meldet sich mit diesem Schlüssel. Vergleichen Sie den Fingerprint mit dem Server, z. B. per `ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub`."
          }
        }
      }
    },
