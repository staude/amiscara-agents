    "%@" : {
      "shouldTranslate" : false
    },
    "%@ (%@) meldet sich mit diesem Schlüssel. Vergleichen Sie den Fingerprint mit dem Server, z. B. per `ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub`." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$@) meldet sich mit diesem Schlüssel. Vergleichen Sie den Fingerprint mit dem Server, z. B. per `ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub`."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@) presents this key. Compare the fingerprint with the server, for example with `ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub`."
          }
        }
      }
    },
