    },
    "%@ meldet sich mit einem anderen Schlüssel als bisher. Das kann eine Neuinstallation des Servers sein, aber auch ein Angriff. Vertrauen Sie dem neuen Schlüssel nur, wenn Sie den Grund kennen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ presents a different key than before. This can be a reinstalled server, but also an attack. Trust the new key only if you know why it changed."
          }
        }
      }
    },
