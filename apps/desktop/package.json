{
  "name": "amiscara-agents-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "tauri": "tauri",
    "icons": "rsvg-convert -w 1024 -h 1024 icon.svg -o src-tauri/icons/source.png && tauri icon src-tauri/icons/source.png && cd src-tauri/icons && rm -rf source.png android ios Square*.png StoreLogo.png",
    "mock": "vite --mode mock"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.3",
    "@tsconfig/svelte": "^5.0.8",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.0",
    "vite": "^8.3.4"
  }
}
