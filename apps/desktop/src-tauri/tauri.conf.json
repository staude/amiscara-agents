{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Amiscara Agents",
  "identifier": "net.staude.amiscara.agents",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Amiscara Agents",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 420,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "appimage"
    ],
    "category": "DeveloperTool",
    "shortDescription": "herdr-Agents auf Windows und Linux",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "amiscara-agents"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFMEYxMjRBM0VFODNFQ0EKUldUS1B1ZytTaElQcnJsWGVyUHZVRDB3cjVFSVNOUEtMOTNxRUkremNYcUFxV3BnWGdlMjNjeWQK",
      "endpoints": [
        "https://github.com/staude/amiscara-agents-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "version": "../package.json"
}
